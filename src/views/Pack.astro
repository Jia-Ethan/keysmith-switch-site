---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { t, href, type Lang } from "../i18n/ui";
import {
  pick,
  packSource,
  packAccent,
  requestUrl,
  kindLabel,
  componentPath,
  componentSource,
  componentTarget,
  invocation,
  TOOL_LABEL,
  type Pack,
} from "../lib/community";
import { formatDate } from "../lib/release";

interface Props {
  lang: Lang;
  pack: Pack;
}
const { lang, pack } = Astro.props;
const d = t(lang);
const p = d.packs;
const name = pick(pack.name, lang);
const summary = pick(pack.meta.summary, lang) || pick(pack.description, lang);
const source = packSource(pack);
const holds = kindLabel(pack, p);
const components = pack.kind === "harness" ? (pack.components ?? []) : [];
// One row per component and agent: where it is in the pack, where it goes.
const installRows = components.flatMap((c) =>
  c.tools.map((tool) => ({ c, tool, from: componentPath(c), to: componentTarget(c, tool) })).filter((row) => row.to),
);
const hasSkill = components.some((c) => c.type === "skill");
const sharedSkills = components.some((c) => c.type === "skill" && c.tools.includes("codex"));
const codexAgent = components.some((c) => c.type === "agent" && c.tools.includes("codex"));
const request = pack.meta.request;
const authorName = pack.meta.author.name ?? `@${pack.meta.author.handle}`;
---

<Base lang={lang} title={name} description={summary} active="packs">
  <section class="wrap page-top pk-detail" style={`--pk-accent:${packAccent(pack)}`}>
    <a class="pk-back" href={href(lang, "/packs/")}>{p.back}</a>

    <div class="page-head">
      <h1 class="display">{name}</h1>
      <p class="lead">{summary}</p>
      <p class="pk-author">
        {
          request?.by && (
            <>
              <span>{p.ideaBy}</span>
              <a href={`https://github.com/${request.by}`} target="_blank" rel="noopener">@{request.by}</a>
              <span class="pk-sep">·</span>
            </>
          )
        }
        <span>{request?.by ? p.builtBy : p.by}</span>
        {
          pack.meta.author.url ? (
            <a href={pack.meta.author.url} target="_blank" rel="noopener">{authorName}</a>
          ) : (
            <span>{authorName}</span>
          )
        }
        {
          request && (
            <>
              <span class="pk-sep">·</span>
              <a href={requestUrl(request.issue)} target="_blank" rel="noopener">{p.fromRequest(request.issue)}</a>
            </>
          )
        }
      </p>
    </div>

    <dl class="pk-facts">
      <div class="pk-fact">
        <dt>{p.tools}</dt>
        <dd class="pk-tools">{pack.tools.map((tool) => <span class="chip">{TOOL_LABEL[tool]}</span>)}</dd>
      </div>
      <div class="pk-fact">
        <dt>{p.version}</dt>
        <dd class="mono">v{pack.version}</dd>
      </div>
      <div class="pk-fact">
        <dt>{holds}</dt>
        <dd class="mono">{(pack.size / 1024).toFixed(1)} KB</dd>
      </div>
      {
        pack.meta.submitted_at && (
          <div class="pk-fact">
            <dt>{p.updated}</dt>
            <dd class="mono">{formatDate(`${pack.meta.submitted_at}T00:00:00Z`, lang)}</dd>
          </div>
        )
      }
      {
        pack.kind === "harness" && pack.tier === 1 && (
          <div class="pk-fact">
            <dt>{p.tierTitle}</dt>
            <dd>{p.tier1}</dd>
          </div>
        )
      }
      {
        pack.license?.spdx && (
          <div class="pk-fact">
            <dt>{p.licenseTitle}</dt>
            <dd class="mono">{pack.license.spdx}</dd>
          </div>
        )
      }
    </dl>

    {
      pack.items && pack.items.length > 0 && (
        <ul class="pk-items">
          {pack.items.map((item) => (
            <li class="pk-item">
              <span class="pk-item-tool chip">{TOOL_LABEL[item.tool]}</span>
              <span class="pk-item-title">{pick(item.title, lang)}</span>
              {item.tags && item.tags.length > 0 && (
                <span class="pk-item-tags mono">{item.tags.join(" · ")}</span>
              )}
            </li>
          ))}
        </ul>
      )
    }

    {
      components.length > 0 && (
        <ul class="pk-items">
          {components.map((c) => (
            <li class="pk-item">
              <span class="pk-item-tool chip">{p.componentType[c.type]}</span>
              <a class="pk-item-name mono" href={componentSource(pack, c)} target="_blank" rel="noopener">{invocation(c)}</a>
              <span class="pk-item-title">{pick(c.title, lang)}</span>
              <span class="pk-item-tags mono">{c.tools.map((tool) => TOOL_LABEL[tool]).join(" · ")}</span>
            </li>
          ))}
        </ul>
      )
    }

    <div class="pk-how">
      <h2 class="h3">{p.howTitle}</h2>
      <p>{components.length > 0 ? p.harnessHow : p.how}</p>
      {
        installRows.length > 0 && (
          <div class="pk-install">
            <table>
              <thead>
                <tr>
                  <th>{p.colComponent}</th>
                  <th>{p.colAgent}</th>
                  <th>{p.colFrom}</th>
                  <th>{p.colTo}</th>
                </tr>
              </thead>
              <tbody>
                {installRows.map((row) => (
                  <tr>
                    <td class="mono">{invocation(row.c)}</td>
                    <td>{TOOL_LABEL[row.tool]}</td>
                    <td class="mono">{row.from}</td>
                    <td class="mono">{row.to}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
      {
        installRows.length > 0 && (
          <ul class="pk-notes">
            {hasSkill && <li>{p.noteSkillFolder}</li>}
            {sharedSkills && <li>{p.noteSharedSkills}</li>}
            {codexAgent && <li>{p.noteCodexAgent}</li>}
            <li>{p.noteEnv}</li>
          </ul>
        )
      }
      <div class="pk-how-acts">
        <a class="btn-line" href={source} target="_blank" rel="noopener"><Icon name="github" size={14} /><span>{p.view}</span></a>
        <a class="link-more" href={href(lang, "/download/")}><span>{p.starCta}</span></a>
      </div>
    </div>

    <p class="pk-disclaimer">{p.disclaimer}</p>
  </section>
</Base>

<style>
  .pk-detail {
    --pk-accent: var(--accent);
  }
  .pk-back {
    display: inline-block;
    margin-bottom: 20px;
    font-size: var(--t-sm);
    color: var(--ink-2);
    text-decoration: none;
  }
  .pk-back:hover {
    color: var(--accent);
  }
  .pk-author {
    margin: 14px 0 0;
    font-size: var(--t-sm);
    color: var(--ink-3);
  }
  .pk-author {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .pk-sep {
    color: var(--ink-3);
  }
  .pk-author a {
    color: var(--accent);
    text-decoration: none;
  }
  .pk-author a:hover {
    text-decoration: underline;
  }

  .pk-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1px;
    margin: 32px 0 0;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--line);
    overflow: hidden;
  }
  .pk-fact {
    background: var(--surface);
    padding: 16px 18px;
  }
  .pk-fact dt {
    font-size: var(--t-label);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 8px;
  }
  .pk-fact dd {
    margin: 0;
    font-size: var(--t-sm);
    color: var(--ink-1);
  }
  .pk-tools {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .pk-items {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .pk-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 18px;
    border-bottom: 1px solid var(--line);
  }
  .pk-item:last-child {
    border-bottom: none;
  }
  .pk-item-title {
    flex: 1;
    font-size: var(--t-sm);
    color: var(--ink-1);
  }
  .pk-item-tags {
    font-size: 11px;
    color: var(--ink-3);
  }
  .pk-item-name {
    font-size: var(--t-sm);
    color: var(--accent);
    text-decoration: none;
  }
  @media (max-width: 640px) {
    .pk-item {
      flex-wrap: wrap;
      row-gap: 6px;
    }
    .pk-item-title {
      flex: 1 1 100%;
      order: 3;
    }
    .pk-item-tags {
      order: 4;
    }
  }
  .pk-item-name:hover {
    text-decoration: underline;
  }

  .pk-install {
    overflow-x: auto;
    margin: 0 0 14px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
  }
  .pk-install table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--t-sm);
  }
  .pk-install th,
  .pk-install td {
    padding: 9px 14px;
    text-align: left;
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
  }
  .pk-install tr:last-child td {
    border-bottom: none;
  }
  .pk-install th {
    font-size: var(--t-label);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--ink-3);
    font-weight: 500;
  }
  .pk-install td {
    color: var(--ink-1);
  }
  .pk-install td.mono {
    font-size: 12px;
  }
  .pk-notes {
    margin: 0 0 18px;
    padding-left: 18px;
    color: var(--ink-2);
    font-size: var(--t-sm);
    max-width: 72ch;
  }
  .pk-notes li + li {
    margin-top: 4px;
  }

  .pk-how {
    margin-top: 36px;
    padding: 24px;
    border-radius: 12px;
    background: var(--surface-2);
    border-left: 3px solid var(--pk-accent);
  }
  .pk-how p {
    margin: 10px 0 18px;
    color: var(--ink-2);
    max-width: 62ch;
  }
  .pk-how-acts {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .pk-disclaimer {
    margin: 28px 0 0;
    font-size: var(--t-sm);
    color: var(--ink-3);
  }
</style>
