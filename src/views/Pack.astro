---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { t, href, type Lang } from "../i18n/ui";
import { pick, packSource, packAccent, TOOL_LABEL, type Pack } from "../lib/community";
import { formatDate } from "../lib/release";

interface Props {
  lang: Lang;
  pack: Pack;
}
const { lang, pack } = Astro.props;
const d = t(lang);
const p = d.packs;
const name = pick(pack.name, lang);
const summary = pick(pack.meta.summary, lang) || pick(pack.description, lang);
const source = packSource(pack);
const kindLabel = pack.kind === "rules" ? p.rulesKind : p.items(pack.item_count);
---

<Base lang={lang} title={name} description={summary} active="packs">
  <section class="wrap page-top pk-detail" style={`--pk-accent:${packAccent(pack)}`}>
    <a class="pk-back" href={href(lang, "/packs/")}>{p.back}</a>

    <div class="page-head">
      <h1 class="display">{name}</h1>
      <p class="lead">{summary}</p>
      <p class="pk-author">
        {p.by}
        {
          pack.meta.author.url ? (
            <a href={pack.meta.author.url} target="_blank" rel="noopener">{pack.meta.author.name ?? `@${pack.meta.author.handle}`}</a>
          ) : (
            <span>{pack.meta.author.name ?? `@${pack.meta.author.handle}`}</span>
          )
        }
      </p>
    </div>

    <dl class="pk-facts">
      <div class="pk-fact">
        <dt>{p.tools}</dt>
        <dd class="pk-tools">{pack.tools.map((tool) => <span class="chip">{TOOL_LABEL[tool]}</span>)}</dd>
      </div>
      <div class="pk-fact">
        <dt>{p.version}</dt>
        <dd class="mono">v{pack.version}</dd>
      </div>
      <div class="pk-fact">
        <dt>{kindLabel}</dt>
        <dd class="mono">{(pack.size / 1024).toFixed(1)} KB</dd>
      </div>
      {
        pack.meta.submitted_at && (
          <div class="pk-fact">
            <dt>{p.updated}</dt>
            <dd class="mono">{formatDate(`${pack.meta.submitted_at}T00:00:00Z`, lang)}</dd>
          </div>
        )
      }
      {
        pack.license?.spdx && (
          <div class="pk-fact">
            <dt>{p.licenseTitle}</dt>
            <dd class="mono">{pack.license.spdx}</dd>
          </div>
        )
      }
    </dl>

    {
      pack.items && pack.items.length > 0 && (
        <ul class="pk-items">
          {pack.items.map((item) => (
            <li class="pk-item">
              <span class="pk-item-tool chip">{TOOL_LABEL[item.tool]}</span>
              <span class="pk-item-title">{pick(item.title, lang)}</span>
              {item.tags && item.tags.length > 0 && (
                <span class="pk-item-tags mono">{item.tags.join(" · ")}</span>
              )}
            </li>
          ))}
        </ul>
      )
    }

    <div class="pk-how">
      <h2 class="h3">{p.howTitle}</h2>
      <p>{p.how}</p>
      <div class="pk-how-acts">
        <a class="btn-line" href={source} target="_blank" rel="noopener"><Icon name="github" size={14} /><span>{p.view}</span></a>
        <a class="link-more" href={href(lang, "/download/")}><span>{p.starCta}</span></a>
      </div>
    </div>

    <p class="pk-disclaimer">{p.disclaimer}</p>
  </section>
</Base>

<style>
  .pk-detail {
    --pk-accent: var(--accent);
  }
  .pk-back {
    display: inline-block;
    margin-bottom: 20px;
    font-size: var(--t-sm);
    color: var(--ink-2);
    text-decoration: none;
  }
  .pk-back:hover {
    color: var(--accent);
  }
  .pk-author {
    margin: 14px 0 0;
    font-size: var(--t-sm);
    color: var(--ink-3);
  }
  .pk-author a {
    color: var(--accent);
    text-decoration: none;
  }
  .pk-author a:hover {
    text-decoration: underline;
  }

  .pk-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1px;
    margin: 32px 0 0;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--line);
    overflow: hidden;
  }
  .pk-fact {
    background: var(--surface);
    padding: 16px 18px;
  }
  .pk-fact dt {
    font-size: var(--t-label);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 8px;
  }
  .pk-fact dd {
    margin: 0;
    font-size: var(--t-sm);
    color: var(--ink-1);
  }
  .pk-tools {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .pk-items {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .pk-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 18px;
    border-bottom: 1px solid var(--line);
  }
  .pk-item:last-child {
    border-bottom: none;
  }
  .pk-item-title {
    flex: 1;
    font-size: var(--t-sm);
    color: var(--ink-1);
  }
  .pk-item-tags {
    font-size: 11px;
    color: var(--ink-3);
  }

  .pk-how {
    margin-top: 36px;
    padding: 24px;
    border-radius: 12px;
    background: var(--surface-2);
    border-left: 3px solid var(--pk-accent);
  }
  .pk-how p {
    margin: 10px 0 18px;
    color: var(--ink-2);
    max-width: 62ch;
  }
  .pk-how-acts {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .pk-disclaimer {
    margin: 28px 0 0;
    font-size: var(--t-sm);
    color: var(--ink-3);
  }
</style>
