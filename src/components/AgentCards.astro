---
import Rich from "./Rich.astro";
import Icon from "./Icon.astro";
import AgentLogo, { type AgentId } from "./AgentLogo.astro";
import { t, href, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).cards;

// Adapter versions are pinned in the app (ToolKind::expected_version).
const AGENTS: { id: AgentId; name: string; adapter: string; version: string; repo: string }[] = [
  { id: "claude", name: "Claude Code", adapter: "claude-keysmith", version: "7.2", repo: "https://github.com/Jia-Ethan/claude-keysmith" },
  { id: "codex", name: "Codex", adapter: "codex-keysmith", version: "0.6.0", repo: "https://github.com/Jia-Ethan/codex-keysmith" },
  { id: "grok", name: "Grok Build", adapter: "grok-keysmith", version: "0.7.0", repo: "https://github.com/Jia-Ethan/grok-keysmith" },
  { id: "zcode", name: "ZCode", adapter: "zcode-keysmith", version: "0.3.2", repo: "https://github.com/Jia-Ethan/zcode-keysmith" },
];
---

<section class="section wrap" id="agents" aria-labelledby="agents-h">
  <h2 class="h2 section-head" id="agents-h"><Rich segs={d.title} /></h2>
  <div class="pk-grid">
    {
      AGENTS.map((a) => {
        const c = d.agents[a.id];
        return (
          <article class="pk" style={`--agent: var(--agent-${a.id})`}>
            <div class="pk-head">
              <AgentLogo agent={a.id} class="pk-logo" />
              <h3>{a.name}</h3>
              <span class="pk-tag">{d.platforms}</span>
            </div>
            <div class="pk-price">
              <b>v{a.version}</b>
              <span>/ {a.adapter}</span>
            </div>
            <p class="pk-who">{c.who}</p>
            <a class="pk-cta" href={a.repo} target="_blank" rel="noopener">
              {d.source}
              <Icon name="out" />
            </a>
            <ul class="pk-f">
              {c.yes.map((line) => (
                <li>{line}</li>
              ))}
              {c.no.map((line) => (
                <li class="no">{line}</li>
              ))}
            </ul>
            <div class="pk-files">
              <p>{d.filesLabel}</p>
              <div class="chips">
                {c.files.map((f) => (
                  <span class="chip">{f}</span>
                ))}
              </div>
            </div>
          </article>
        );
      })
    }
  </div>
  <div class="center-more">
    <a class="link-more" href={href(lang, "/docs/agents/")}><span>{d.more}</span><Icon name="arrow" /></a>
  </div>
</section>

<style>
  .pk {
    border-top: 2px solid color-mix(in srgb, var(--agent) 70%, transparent);
  }
</style>
